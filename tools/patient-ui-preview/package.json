{
  "name": "@ubertib/patient-ui-preview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Non-production React Native Web Storybook renderer for the UberTib Patient UI specification.",
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:open": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "typecheck": "tsc --noEmit",
    "playwright:install": "playwright install chromium",
    "test:smoke": "npm run storybook:build && playwright test playwright/smoke.spec.ts --project=patient-390",
    "test:e2e": "npm run storybook:build && playwright test",
    "test:e2e:headed": "npm run storybook:build && playwright test --headed",
    "test:e2e:ui": "npm run storybook:build && playwright test --ui",
    "test:e2e:update": "npm run storybook:build && playwright test --update-snapshots",
    "verify": "npm run typecheck && npm run storybook:build && playwright test playwright/smoke.spec.ts --project=patient-390"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.86.3",
    "react-native-web": "0.21.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/react-native-web-vite": "10.5.10",
    "@types/node": "24.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "storybook": "10.5.10",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
