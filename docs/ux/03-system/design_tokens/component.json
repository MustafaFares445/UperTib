{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "UberTib COMPONENT layer. One group per allocated CMP-*, written in Session 3 alongside COMPONENT_INVENTORY.md so a component and its tokens are never allocated apart. Every value is transcribed from that component's own Token mapping block by docs/ux/scripts/build_component_tokens.py, so the narrative and the source cannot drift. A component token resolves to the semantic layer and nothing else; the gate fails one that reaches a primitive directly.",
  "contract": {
    "$description": "Rules a component token group must satisfy. Enforced by docs/ux/scripts/validate_ux_tokens.py.",
    "naming": {
      "$type": "string",
      "$value": "component.<cmp-id-slug>.<property>-<variant>-<state>",
      "$description": "The group key is the lowercase CMP identifier with its domain, for example component.platform-001. The property, variant and state segments follow the semantic vocabulary already in use - bg, text, border, icon; primary, secondary, destructive; hover, focus, active, disabled."
    },
    "resolution": {
      "$type": "string",
      "$value": "component-resolves-to-semantic-only",
      "$description": "A component token references the semantic layer and nothing else. A component token that reaches a primitive directly is a defect: it makes a theme change miss that component."
    },
    "allocation": {
      "$type": "string",
      "$value": "one-group-per-allocated-CMP",
      "$description": "A group may exist only for an identifier the component inventory has allocated. There is no component token for an unallocated candidate and none for a pattern that never earned a CMP."
    },
    "excluded": {
      "$type": "string",
      "$value": "framework-owned-controls",
      "$description": "No component tokens for button, input, select, checkbox, radio, date picker, modal shell, toast, banner, avatar, badge, tabs or navigation chrome. Profile A takes those from Filament as shipped and Profile C from React Native primitives; both are bound by the semantic layer, the required states and the accessibility obligations, and defining bespoke tokens for them would be phase bleed into implementation."
    },
    "required-groups": {
      "$type": "string",
      "$value": "surface,text,border,state-triple-binding",
      "$description": "Every allocated component declares how it takes a surface, its text, its boundary, and - where it renders a lifecycle status - how it consumes the tone, icon and emphasis triple whole. A component that consumes a tone without the icon and the emphasis fails the gate."
    }
  },
  "component": {
    "$description": "22 allocated groups. Framework-owned controls - button, input, select, checkbox, radio, toggle, date picker, modal shell, drawer, popover, toast, banner, notification, avatar, badge, tag, tabs, breadcrumb, card and navigation chrome - deliberately have NO group here. Profile A takes them from Filament as shipped and Profile C from React Native primitives; both are bound by the semantic layer, the eight required states and the accessibility obligations. Defining bespoke tokens for them would be phase bleed into implementation.",
    "platform-001": {
      "$description": "CMP-PLATFORM-001 - State chip. Contract block: COMPONENT_INVENTORY_PLATFORM.md.",
      "radius": {
        "$type": "dimension",
        "$value": "{semantic.radius.chip}"
      },
      "state-triple-binding": {
        "$type": "string",
        "$value": "tone.*.border,tone.*.emphasis,tone.*.emphasis-border,tone.*.fill,tone.*.icon,tone.*.on-emphasis,tone.*.text",
        "$description": "Tone-parameterised roles. The tone is resolved at render time from state.<machine>.<STATUS>.tone, one of the six governed tones, and the component consumes the triple WHOLE: a component that takes a tone without also taking the icon and the emphasis is a defect, because the state channel exists so that a colour-only status is structurally impossible."
      }
    },
