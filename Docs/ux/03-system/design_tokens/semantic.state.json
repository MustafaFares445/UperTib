{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "UberTib SEMANTIC state channel. Every lifecycle status in the product resolves to a TRIPLE - a tone, an icon and an emphasis - and never to a colour on its own. A component that renders a status consumes the whole triple, which is what makes a colour-only rendering structurally impossible rather than a rule somebody has to remember 82 times. tone, icon and emphasis are $type string, an UberTib extension over DTCG; the token gate checks that every tone names a defined tone group, every icon exists in the governed icon set with a documented meaning, and every emphasis is one of the four defined treatments. Arabic labels for these statuses are NOT here - they are Session 5 TXT-* allocations against the content guide.",
  "icon-set": {
    "$type": "string",
    "$value": "heroicons-2-outline-24",
    "$description": "The governed icon set. Chosen because it is what Filament ships on both panels, so two of the three platforms use it as delivered, and it has a maintained React Native port for the third. Every icon carries a text label; an icon is never the only carrier of meaning."
  },
  "emphasis-scale": {
    "$description": "The four status treatments. Which one a status uses is a rule, not a preference.",
    "muted": {
      "$type": "string",
      "$value": "muted",
      "$description": "Neutral fill, neutral text, no tone colour. Inert or not yet started: nobody has acted and nothing is running."
    },
    "subtle": {
      "$type": "string",
      "$value": "subtle",
      "$description": "Tone fill, tone border, tone text. The default treatment."
    },
    "outline": {
      "$type": "string",
      "$value": "outline",
      "$description": "No fill, tone border, tone text. A closed or historical state that is settled and needs no attention."
    },
    "solid": {
      "$type": "string",
      "$value": "solid",
      "$description": "Tone emphasis fill, on-emphasis text, emphasis border. Reserved for a status that both blocks the actor from proceeding and carries a deadline whose lapse cannot be undone. This is a rule, not a quota: a machine may have two of them, or none."
    }
  },
  "icon-vocabulary": {
    "$description": "Every icon identifier the state channel may use, and the single meaning it carries everywhere. An icon means the same thing in every machine, and no machine may use one icon for two of its own statuses.",
